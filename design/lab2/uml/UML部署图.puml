@startuml
skinparam dpi 150
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 12
skinparam roundCorner 8
skinparam arrowColor #7A8291
skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #C9CFD8
  FontColor #15171C
}
skinparam databaseBackgroundColor #F7F7F9
skinparam artifactBackgroundColor #FDF5F0
skinparam nodesep 40
skinparam ranksep 58

title 图3　部署图 —— 原型阶段的部署结构

node "用户手机（iOS / Android）" as PHONE #FDF5F0 {
  artifact "顾客端 App\n(WebView + H5 原型)" as A1
  artifact "商家端 App" as A2
  artifact "骑手端 App" as A3
}

node "运营人员 PC（Windows / macOS）" as PC #FDF5F0 {
  artifact "平台管理后台\n(浏览器访问)" as A4
}

node "接入服务器" as EDGE #F3F7FD {
  node "Nginx\nHTTPS 终止 · 静态资源 · 反向代理" as NGX
}

node "应用服务器（云主机 / Docker）" as APP #FFFFFF {
  node "API 网关容器" as GW
  node "业务服务容器组\n用户 / 商家 / 订单 / 配送 / 售后 / 消息 / 统计" as SVC
  node "定时任务容器\n超时取消 · 自动同意 · 重派单" as JOB
}

node "数据服务器" as DATA #F2FBF6 {
  database "MySQL 8.0\n主从复制 · 每日备份" as DB
  database "Redis 7\n会话 / 库存预占 / 抢单锁" as RD
}

node "对象存储服务" as OBJ #F2FBF6 {
  database "OSS / 本地文件服务\n证照图片 · 门店图片" as OSS
}

node "第三方服务（预留）" as THIRD #F7F7F9 {
  artifact "短信 / 微信登录\n（原型阶段以模拟实现替代）" as TH
}

A1 --> NGX : HTTPS
A2 --> NGX : HTTPS
A3 --> NGX : HTTPS
A4 --> NGX : HTTPS
NGX --> GW : 反向代理
GW --> SVC
JOB --> DB
SVC --> DB : JDBC
SVC --> RD : 连接池
SVC --> OSS : SDK
SVC ..> TH : 可选接入

note bottom of APP
  原型阶段所有服务可部署在同一台主机上，
  以不同容器隔离；后续按量拆分即可横向扩容。
  抢单与库存扣减依赖 Redis 分布式锁保证一致性。
end note

@enduml
