@startuml
skinparam dpi 150
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 12
skinparam roundCorner 8
skinparam componentStyle rectangle
skinparam arrowColor #7A8291
skinparam arrowFontSize 11
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #C9CFD8
  FontColor #15171C
}
skinparam packageBorderColor #D8DCE3
skinparam packageBackgroundColor #FCFCFD
skinparam nodesep 26
skinparam ranksep 46

title 图2　组件图 —— 系统分层结构与模块依赖

package "① 客户端层" #FDF5F0 {
  component "顾客端 App\n点餐 / 下单 / 追踪 / 售后" as CUST
  component "商家端 App\n接单 / 菜品库存 / 出餐" as MER
  component "骑手端 App\n抢单 / 配送执行 / 异常上报" as RID
  component "平台管理后台\n审核 / 仲裁 / 看板 / 日志" as ADM
}

package "② 接入层" #F3F7FD {
  component "API 网关\n鉴权 · 限流 · 路由 · 埋点" as GW
}

package "③ 业务服务层" #FFFFFF {
  component "用户服务\n账号 / 角色 / 地址" as US
  component "商家服务\n店铺 / 菜单 / 库存" as MS
  component "订单服务\n购物车 / 订单状态机" as OS
  component "配送服务\n派单 / 抢单 / 轨迹" as DS
  component "支付服务（模拟）\n支付 / 退款" as PS
  component "售后仲裁服务\n退款审核 / 责任判定" as AS
  component "消息通知服务\n推送 / 站内信" as NS
  component "运营统计服务\n看板 / 报表" as SS
}

package "④ 任务调度层" #F2FBF6 {
  component "定时任务\n接单超时取消 · 退款超时自动同意 · 派单超时重派" as JOB
}

package "⑤ 数据访问层" #F7F7F9 {
  component "数据访问组件 Repository\n统一事务 · 缓存读写 · 文件上传" as DAO
}

package "⑥ 基础设施层" #F2FBF6 {
  database "MySQL\n业务主数据" as DB
  database "Redis\n会话 · 库存预占 · 抢单锁" as RD
  database "对象存储\n证照 / 门店图片" as OSS
}

CUST --> GW : HTTPS
MER --> GW
RID --> GW
ADM --> GW

GW --> US
GW --> MS
GW --> OS
GW --> DS
GW --> AS
GW --> SS

OS --> US : 校验地址
OS --> MS : 校验并预占库存
OS --> PS : 发起支付
OS --> DS : 创建配送单
AS --> PS : 执行退款
OS --> NS : 状态变更推送
DS --> NS : 派单通知

JOB --> OS : 超时取消订单
JOB --> DS : 超时重新派单
JOB --> AS : 退款自动同意

US --> DAO
MS --> DAO
OS --> DAO
DS --> DAO
PS --> DAO
AS --> DAO
SS --> DAO : 只读查询

DAO --> DB
DAO --> RD
DAO --> OSS

note right of GW
  所有外部请求统一在网关完成
  角色鉴权与限流；服务之间通过
  内部接口（REST）调用，
  由订单服务作为主控编排流程。
end note

note bottom of JOB
  与业务解耦的补偿机制：
  任何超时未推进的订单，
  都由定时任务兜底，保证状态最终一致。
end note

@enduml
